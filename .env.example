# --- Auth.js ---
# Generate with: npx auth secret
AUTH_SECRET=

# Discord OAuth application (Developer Portal → your app → OAuth2)
AUTH_DISCORD_ID=
AUTH_DISCORD_SECRET=

# --- Discord gating & roles (PLAN §3) ---
# VOID's Discord server (guild) id — login is gated to members of this server.
VOID_GUILD_ID=
# Comma-separated Discord user ids that are ALWAYS Admin (failsafe).
ADMIN_DISCORD_IDS=
# JSON map of Discord role id -> app role, e.g. {"1234":"officer","5678":"admin"}
DISCORD_ROLE_MAP={}

# --- Site / metadata ---
# Deployed origin (no trailing slash). Used as metadataBase so Open Graph and
# Twitter card URLs (e.g. the /signin unfurl image) resolve to absolute links.
# Defaults to http://localhost:3000 in dev if unset.
NEXT_PUBLIC_SITE_URL=

# --- Database (Neon Postgres) ---
# Connection string from the Neon dashboard (use the pooled URL).
DATABASE_URL=
