# --- Auth.js ---
# Generate with: npx auth secret
AUTH_SECRET=

# Discord OAuth application (Developer Portal → your app → OAuth2)
AUTH_DISCORD_ID=
AUTH_DISCORD_SECRET=

# --- Discord gating & roles (PLAN §3) ---
# VOID's Discord server (guild) id — login is gated to members of this server.
VOID_GUILD_ID=
# Comma-separated Discord user ids that are ALWAYS Admin (failsafe).
ADMIN_DISCORD_IDS=
# JSON map of Discord role id -> app role, e.g. {"1234":"officer","5678":"admin"}
DISCORD_ROLE_MAP={}

# --- Database (Neon Postgres) ---
# Connection string from the Neon dashboard (use the pooled URL).
DATABASE_URL=
